# Template for .env on the DEV server (/data/stack/apps/time-4-action/warranty-form/.env).
# Never copy the production .env here. MONGODB_URI is set by docker-compose.dev.yml (local
# mock Mongo), so it is not needed here.

# Also needed at runtime: the boot check in src/lib/env.ts reads it.
NEXT_PUBLIC_MAPBOX_API_KEY=

# Same bucket as production, but under a dev prefix so test uploads never mix with real claims.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=patrik-assets
S3_PUBLIC_BASE=https://patrik-assets.fsn1.your-objectstorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=dev/uploads/warranty

# DEV spreadsheet, never the production one.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=

BASE_URL=https://warranty.dev.patrik-international.com

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Patrik Warranty DEV <noreply@patrikinternational.com>"
# Every email (customer confirmation + admin notification) goes here instead of real recipients.
MAIL_REDIRECT_TO=

# Must match t4a-admin's dev env if the dev admin should talk to this instance.
INTERNAL_ADMIN_TOKEN=

# Leave Sentry / GA unset in dev.
