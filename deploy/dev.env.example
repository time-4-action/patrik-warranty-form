# Template for .env on the DEV server (/data/stack/apps/patrik-international/warranty/.env).
# Never copy the production .env here. DATABASE_URL is set by docker-compose.dev.yml (local
# mock Postgres), so it is not needed here.

# NEXT_PUBLIC_MAPBOX_API_KEY is not set here: CI bakes it into the image from the
# NEXT_PUBLIC_MAPBOX_API_KEY repository variable (build time + runtime).

# Same bucket as production, but under a dev prefix so test uploads never mix with real claims.
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_BUCKET=t4a
S3_PUBLIC_BASE=https://assets.patrik-international.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=dev/uploads/warranty

# DEV spreadsheet, never the production one.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=

BASE_URL=https://warranty.dev.patrik-international.com

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Patrik Warranty DEV <noreply@patrikinternational.com>"
# Every email (customer confirmation + admin notification) goes here instead of real recipients.
MAIL_REDIRECT_TO=

# Must match t4a-admin's dev env if the dev admin should talk to this instance.
INTERNAL_ADMIN_TOKEN=
# Read-only token for the T4A agent (GET claim routes + /api/admin/stats only). Optional.
# Generate with `openssl rand -hex 32`; must match the dev t4a-agent's env.
INTERNAL_READ_TOKEN=

# Leave Sentry / GA unset in dev.
